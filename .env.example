# Environment variables that tsiam reads
# Everything else is set in the configuration file

# Path to the configuration file
# If unset, tsiam looks for config.yaml in the current directory, ~/.tsiam, and /etc/tsiam
#TSIAM_CONFIG=/etc/tsiam/config.yaml

# Tailscale auth key, used to join the tailnet the first time tsiam starts
# Same as tsnet.authKey in the configuration file
#TS_AUTHKEY=tskey-auth-xxx

# Send logs, metrics, and traces to an OpenTelemetry collector
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#OTEL_SERVICE_NAME=tsiam
